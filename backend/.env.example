# Local dev: leave unset — falls back to sqlite:///./carenote.db
# Production (Render): set automatically if using render.yaml with the bundled
# Postgres, otherwise paste your Render Postgres "External Database URL".
DATABASE_URL=

# Your deployed Vercel frontend URL, no trailing slash. Required for CORS.
FRONTEND_URL=

# Optional: comma-separated extra origins to allow (e.g. Vercel preview URLs).
EXTRA_ALLOWED_ORIGINS=

# Optional: enables real AI drafting via Claude instead of the offline mock.
ANTHROPIC_API_KEY=
