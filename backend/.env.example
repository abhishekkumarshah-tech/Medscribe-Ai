# Local development uses SQLite and seeds synthetic demo records by default.
DATABASE_URL=sqlite:///./carenote.db
APP_ENV=development

# Public account registration defaults on in development and off in production.
# Set ALLOW_SIGNUP=true in production only if public self-registration is intended.
ALLOW_SIGNUP=true
SEED_DEMO_DATA=true
SESSION_TTL_HOURS=12

# Optional CORS origins for a separately hosted frontend (exact origins only).
# Leave these unset when the frontend is served from the same Render service.
FRONTEND_URL=
EXTRA_ALLOWED_ORIGINS=

# Optional hosted drafting. Without the key, deterministic local structuring is used.
# If configured, consultation note text is sent to Anthropic; do not use real PHI.
ANTHROPIC_API_KEY=
CARENOTE_AI_MODEL=claude-sonnet-4-6
